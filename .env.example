# Local development only. Never commit .env.local.
DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/fantasy_arena
API_FOOTBALL_KEY=replace_me_locally
API_FOOTBALL_BASE_URL=https://v3.football.api-sports.io
FOOTBALL_SEASON=2026
# Fill these only after npm run football:discover confirms the correct IDs and coverage.
API_FOOTBALL_EPL_LEAGUE_ID=
API_FOOTBALL_LALIGA_LEAGUE_ID=
SYNC_FROM=2026-07-01
SYNC_TO=2027-06-30
# Use a long random value for protected admin/cron operations.
FOOTBALL_DISCOVERY_TOKEN=
